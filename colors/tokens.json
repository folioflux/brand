{
  "$description": "FolioFlux brand tokens. Source of truth for colors/tokens.css (run scripts/build_kit.py). Values follow the Design Tokens Community Group format.",
  "color": {
    "core": {
      "black":   { "$type": "color", "$value": "#000000", "$description": "Canvas. The default background for FolioFlux surfaces." },
      "card":    { "$type": "color", "$value": "#141414", "$description": "Cards, tables and panels on the black canvas." },
      "green":   { "$type": "color", "$value": "#2BBC62", "$description": "Brand green. One filled primary action per region, threads, the mark's flux bar. Labels on green are black." },
      "magenta": { "$type": "color", "$value": "#FF00DD", "$description": "Editorial accent. At most once per frame or viewport. Never a status. Labels on magenta are black." },
      "paper":   { "$type": "color", "$value": "#F4F3EE", "$description": "Receipt paper and the light background." },
      "white":   { "$type": "color", "$value": "#FFFFFF", "$description": "Text on the black canvas and the F of the mark." }
    },
    "support": {
      "raised":      { "$type": "color", "$value": "#1A1A1A", "$description": "Raised or hovered surface on dark." },
      "hairline":    { "$type": "color", "$value": "#2A2A2A", "$description": "Dividers on dark, and the outline of the mark on black." },
      "boundary":    { "$type": "color", "$value": "#666666", "$description": "Control edges and outline tags on dark." },
      "muted":       { "$type": "color", "$value": "#B3B3B3", "$description": "Muted text and mono labels on dark." },
      "ink":         { "$type": "color", "$value": "#111111", "$description": "Text on paper and light backgrounds." },
      "paper-shade": { "$type": "color", "$value": "#C9C9C4", "$description": "Grey end of the paper gradient, ledger lines." },
      "paper-muted": { "$type": "color", "$value": "#4A4A45", "$description": "Muted text on paper." },
      "green-ink":   { "$type": "color", "$value": "#0F7A3A", "$description": "Green as text or a stamp on light backgrounds (meets 4.5:1 on paper)." },
      "magenta-ink": { "$type": "color", "$value": "#FF52D1", "$description": "Magenta as text on dark." },
      "magenta-ink-light": { "$type": "color", "$value": "#B0009B", "$description": "Magenta as text on light." }
    },
    "theme": {
      "dark": {
        "canvas": { "$type": "color", "$value": "#000000" },
        "surface": { "$type": "color", "$value": "#141414" },
        "raised": { "$type": "color", "$value": "#1A1A1A" },
        "text": { "$type": "color", "$value": "#FFFFFF" },
        "text-secondary": { "$type": "color", "$value": "#E0E0E0" },
        "text-muted": { "$type": "color", "$value": "#B3B3B3" },
        "boundary": { "$type": "color", "$value": "#666666" },
        "hairline": { "$type": "color", "$value": "#2A2A2A" },
        "brand": { "$type": "color", "$value": "#2BBC62" },
        "brand-foreground": { "$type": "color", "$value": "#000000" },
        "brand-ink": { "$type": "color", "$value": "#2BBC62" },
        "highlight": { "$type": "color", "$value": "#FF00DD" },
        "highlight-foreground": { "$type": "color", "$value": "#000000" },
        "highlight-ink": { "$type": "color", "$value": "#FF52D1" }
      },
      "light": {
        "canvas": { "$type": "color", "$value": "#F6F6F4" },
        "surface": { "$type": "color", "$value": "#FFFFFF" },
        "raised": { "$type": "color", "$value": "#EEEEEC" },
        "text": { "$type": "color", "$value": "#111111" },
        "text-secondary": { "$type": "color", "$value": "#2E2E2E" },
        "text-muted": { "$type": "color", "$value": "#535353" },
        "boundary": { "$type": "color", "$value": "#767676" },
        "hairline": { "$type": "color", "$value": "#DCDCD8" },
        "brand": { "$type": "color", "$value": "#2BBC62" },
        "brand-foreground": { "$type": "color", "$value": "#000000" },
        "brand-ink": { "$type": "color", "$value": "#0F7A3A" },
        "highlight": { "$type": "color", "$value": "#FF00DD" },
        "highlight-foreground": { "$type": "color", "$value": "#000000" },
        "highlight-ink": { "$type": "color", "$value": "#B0009B" }
      }
    }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Archivo", "Arial Narrow", "sans-serif"], "$description": "Headlines and the wordmark. Weight 800; compressed to 62-80% width for display, 87.5% (SemiCondensed) for the wordmark." },
    "sans":    { "$type": "fontFamily", "$value": ["Instrument Sans", "system-ui", "sans-serif"], "$description": "Body, UI and data. Weights 400 and 600." },
    "mono":    { "$type": "fontFamily", "$value": ["Fragment Mono", "ui-monospace", "monospace"], "$description": "Labels, tags and the highlight word. Uppercase, tracked 0.12em." }
  },
  "radius": {
    "tag":     { "$type": "dimension", "$value": "2px" },
    "control": { "$type": "dimension", "$value": "8px" },
    "panel":   { "$type": "dimension", "$value": "12px" },
    "pill":    { "$type": "dimension", "$value": "9999px" }
  },
  "spacing": { "$type": "dimension", "$value": ["4px", "8px", "12px", "16px", "24px", "32px", "48px", "64px", "96px"] },
  "logo": {
    "min-size":   { "$type": "dimension", "$value": "16px", "$description": "Smallest rendered size of the mark." },
    "clear-space": { "$type": "number", "$value": 0.25, "$description": "Clear space on every side, as a fraction of the mark's height." }
  }
}
